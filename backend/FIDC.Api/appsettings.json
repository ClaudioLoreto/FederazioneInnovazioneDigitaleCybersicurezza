{
  // =========================================================================
  //  appsettings.json — configurazione di PRODUZIONE (Windows Server 2019)
  //  Provider attivo: SqlServer. La connection string punta a SQL Server 2019.
  //  I segreti reali (Jwt:Key, Resend:ApiKey) vanno in variabili d'ambiente
  //  o User-Secrets, MAI committati.
  // =========================================================================
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    // Profilo PRODUZIONE — SQL Server 2019 / SSMS
    "SqlServer": "Server=localhost;Database=FIDC;Trusted_Connection=True;TrustServerCertificate=True;",
    // Profilo DEV/TEST — PostgreSQL (Railway/Docker). Sovrascritto in Development.
    "Postgres": "Host=localhost;Port=5432;Database=fidc_dev;Username=fidc;Password=dev_only_password"
  },
  "Jwt": {
    "Key": "CHANGE_ME_super_secret_key_min_32_chars_長__use_env_in_prod",
    "Issuer": "fidc.it",
    "Audience": "fidc.it",
    "ExpiresHours": "8"
  },
  "Resend": {
    "ApiKey": "re_REPLACE_WITH_ENV_VAR",
    "FromAddress": "FIDC <noreply@fidc.it>",
    "FrontendBaseUrl": "https://www.fidc.it",
    "ApiBaseUrl": "https://api.resend.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "BypassEmailConfirmation": false
  },
}
