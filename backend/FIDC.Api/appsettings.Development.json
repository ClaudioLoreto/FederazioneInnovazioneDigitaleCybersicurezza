{
  // =========================================================================
  //  appsettings.Development.json — DEV LOCALE (SQLite, NESSUN Docker)
  //  Provider: SQLite su file fidc_dev.db nella cartella di esecuzione.
  //  Scelto per un demo "a prova di errore": niente Postgres/Docker da avviare.
  //  (Per usare Postgres/Docker basta rimettere "Provider": "Postgres".)
  // =========================================================================
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=fidc_dev.db",
    "Postgres": "Host=localhost;Port=5433;Database=fidc_dev;Username=fidc;Password=dev_only_password"
  },
  "Jwt": {
    "Key": "dev_only_jwt_key_change_me_min_32_chars_0123456789",
    "Issuer": "fidc.local",
    "Audience": "fidc.local",
    "ExpiresHours": "8"
  },
  "Auth": {
    "BypassEmailConfirmation": true
  },
  // Dati dimostrativi (relatori, eventi, news, documenti di esempio): spenti.
  // I contenuti si inseriscono dal backoffice. Metti true per provare il sito
  // con contenuti finti; vale solo su un database nuovo (cancella fidc_dev.db).
  "Seed": {
    "DatiDimostrativi": false
  },
  "Resend": {
    "ApiKey": "re_dev_test_key",
    "FromAddress": "FIDC Dev <onboarding@resend.dev>",
    "FrontendBaseUrl": "http://localhost:4200",
    "ApiBaseUrl": "https://api.resend.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
